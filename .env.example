# =====================================================================
# AIRA Database Configuration
# =====================================================================

# 1. Local SQLite (Default - automatically used if DATABASE_URL is not set):
# DATABASE_URL=sqlite:///shared/data/aira.db

# 2. Remote PostgreSQL Instance (e.g. Supabase, Neon, AWS RDS, Render, Railway, Docker):
# DATABASE_URL=postgresql://username:password@host.example.com:5432/database_name

# Example with SSL mode (recommended for cloud PostgreSQL providers):
# DATABASE_URL=postgresql://postgres:mysecretpassword@aws-rds-postgres.endpoint.com:5432/airadb?sslmode=require

# Supported aliases: DATABASE_URL, POSTGRES_URL, DB_URL
