# =====================================================================
# AIRA Database Configuration
# =====================================================================

# 1. Local SQLite (Default - automatically used if DATABASE_URL is not set):
# DATABASE_URL=sqlite:///shared/data/aira.db

# 2. Remote PostgreSQL Instance (e.g. Supabase, Neon, AWS RDS, Render, Railway, Docker):
# DATABASE_URL=postgresql://username:password@host.example.com:5432/database_name

# Example with SSL mode (recommended for cloud PostgreSQL providers):
# DATABASE_URL=postgresql://postgres:mysecretpassword@aws-rds-postgres.endpoint.com:5432/airadb?sslmode=require

# Supported aliases: DATABASE_URL, POSTGRES_URL, DB_URL

# =====================================================================
# AWS S3 / Cloud Storage Bucket Configuration
# =====================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=assets
# Optional custom endpoint (e.g. Neon S3, MinIO, Cloudflare R2, Wasabi, LocalStack):
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_ENDPOINT_URL_S3=https://<id>.storage.<region>.aws.neon.tech
# Optional custom CDN or public URL base (e.g. CloudFront, custom domain):
# AWS_S3_CUSTOM_DOMAIN=https://cdn.example.com
# Optional presigned URL expiry time (only if signed URLs are explicitly requested)
# AWS_S3_PRESIGNED_EXPIRY=3600

